<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude sensitive database and encrypted vault from plain backup extraction -->
    <exclude domain="sharedpref" path="slidecraft_secure_vault.xml" />
    <exclude domain="database" path="slidecraft_database" />
    <exclude domain="database" path="slidecraft_database-shm" />
    <exclude domain="database" path="slidecraft_database-wal" />
</full-backup-content>
